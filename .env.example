# ---------------------------------------------------------------------------
# HCA System — environment template. Copy to .env and replace every secret.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_USER=hca
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=hca_db

# Application secrets. Generate with:
#   openssl rand -base64 48
JWT_SECRET_KEY=replace-with-a-long-random-jwt-secret
ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

ENVIRONMENT=production
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# First-run administrator (seeded automatically by the backend container).
# Leave SEED_ADMIN_PASSWORD empty to generate a strong password; it is printed
# once in `docker compose logs backend`.
# ---------------------------------------------------------------------------
BOOTSTRAP_ADMIN_ON_STARTUP=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@hca-system.local
# Leave empty to generate a strong password and print it once in the backend log.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FULL_NAME=System Administrator
SEED_ADMIN_DEPARTMENT=IT Administration
SEED_ADMIN_DESIGNATION=System Administrator

# Token lifetimes (minutes / days)
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30
